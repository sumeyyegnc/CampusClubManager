<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusClubManager</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Template CSS -->
    <link href="~/css/styles.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
        <div class="container px-5">

            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Campus Club Manager
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Menüyü Aç">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            Ana Sayfa
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Club" asp-action="Index">
                            Kulüpler
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Event" asp-action="Index">
                            Etkinlikler
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Student" asp-action="Index">
                            Öğrenci Kayıt İçin
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Report" asp-action="Index">
                            Raporlar
                        </a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>

    <!-- Sayfa İçeriği -->
    <div class="container px-4 px-lg-5 mt-4">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="py-5 custom-footer mt-5">
        <div class="container px-4 px-lg-5">
            <p class="m-0 text-center text-white">
                &copy; @DateTime.Now.Year - Campus Club Manager 
            </p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/scripts.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>