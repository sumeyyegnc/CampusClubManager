@model CampusClubManager.Models.Student

<h2>Edit Student</h2>

<form method="post">

    <input type="hidden" name="StudentId" value="@Model.StudentId" />

    <div class="form-group">
        <label>First Name</label>
        <input type="text" name="FirstName" value="@Model.FirstName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Last Name</label>
        <input type="text" name="LastName" value="@Model.LastName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="text" name="Email" value="@Model.Email" class="form-control" />
    </div>

    <div class="form-group">
        <label>Phone</label>
        <input type="text" name="Phone" value="@Model.Phone" class="form-control" />
    </div>

    <div class="form-group">
        <label>Department</label>
        <input type="text" name="Department" value="@Model.Department" class="form-control" />
    </div>

    <div class="form-group">
        <label>Password</label>
        <input type="password" name="Password" value="@Model.Password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
</form>