@model List<CampusClubManager.Models.campuslistview>

<h2>Club - Student - Event List</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Club</th>
            <th>Student</th>
            <th>Event</th>
            <th>Date</th>
            <th>Location</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ClubName</td>
            <td>@item.StudentName</td>
            <td>@item.EventName</td>
            <td>@item.EventDate</td>
            <td>@item.Location</td>
        </tr>
    }
    </tbody>
</table>