@model CampusClubManager.Models.Event
@using CampusClubManager.Models

<h2>Edit Event</h2>

<form method="post">

    <input type="hidden" name="EventId" value="@Model.EventId" />

    <div class="form-group">
        <label>Event Name</label>
        <input type="text" name="EventName" value="@Model.EventName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Event Date</label>
        <input type="datetime-local"
               name="EventDate"
               value="@(Model.EventDate?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" />
    </div>

    <div class="form-group">
        <label>Location</label>
        <input type="text" name="Location" value="@Model.Location" class="form-control" />
    </div>

    <div class="form-group">
        <label>Club</label>
        <select name="ClubId" class="form-control">
            @foreach (var club in ViewBag.Clubs as List<Club>)
            {
                <option value="@club.ClubId" selected="@(club.ClubId == Model.ClubId)">
                    @club.ClubName
                </option>
            }
        </select>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Update</button>
</form>