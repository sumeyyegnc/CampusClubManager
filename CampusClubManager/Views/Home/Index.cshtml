@{
    ViewData["Title"] = "Home Page";
}

<div class="container px-4 px-lg-5">

    <!-- Üst Kısım -->
    <div class="row gx-5 align-items-center my-5">

        <div class="col-lg-7 col-md-12">
            <img class="img-fluid hero-image shadow"
                 src="/images/bookevent.jpg"
                 alt="Kulüp Etkinlikleri" />
        </div>

        <div class="col-lg-5">
            <h1 class="display-5 fw-bold">
                Tutkularını Keşfet, Geleceğini Şekillendir!
            </h1>

            <p class="lead mt-3">
                Bir Kulüp, Binlerce Anı! Spor, kültür ve sosyal etkinliklerle
                dolu kulüplerimiz öğrencileri ortak ilgi alanlarında
                buluşturuyor ve unutulmaz deneyimler sunuyor.
            </p>

            <a class="btn btn-primary btn-lg mt-2" href="Club/Index">
                Kulüpleri Keşfet
            </a>
        </div>

    </div>

    <!-- Duyuru Alanı -->
    <div class="card olive-banner my-5 py-4 text-center shadow">
        <div class="card-body">
            <p class="text-white m-0 fs-5">
                Kulüplerimize katılarak yeni arkadaşlıklar kurabilir,
                etkinliklerde yer alabilir ve kendini geliştirebilirsin.
            </p>
        </div>
    </div>

    <!-- Kulüpler -->
    <div class="row justify-content-center">

        <!-- Koşu -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow">
                <img src="/images/run.jpg"
                     class="card-img-top club-image"
                     alt="Koşu Kulübü">

                <div class="card-body">
                    <h4 class="card-title">🏃 Koşu Kulübü</h4>

                    <p class="card-text">
                        Dayanıklılığını artırmak ve sağlıklı yaşamı desteklemek
                        isteyenler için düzenli antrenmanlar ve grup koşuları sunar.
                    </p>
                </div>
            </div>
        </div>

        <!-- Kahve -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow">
                <img src="/images/first.jpg"
                     class="card-img-top club-image"
                     alt="Kahve Kulübü">

                <div class="card-body">
                    <h4 class="card-title">☕ Kahve Kulübü</h4>

                    <p class="card-text">
                        Kahve tutkunlarını bir araya getiren kulübümüz,
                        farklı kahve kültürlerini keşfetmek ve keyifli
                        sohbetler eşliğinde sosyalleşmek için etkinlikler düzenler.
                    </p>
                </div>
            </div>
        </div>

        <!-- Kitap -->
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow">
                <img src="/images/lib.jpg"
                     class="card-img-top club-image"
                     alt="Kitap Kulübü">

                <div class="card-body">
                    <h4 class="card-title">📚 Kitap Kulübü</h4>

                    <p class="card-text">
                        Kitap okumayı sevenleri bir araya getirir,
                        farklı eserler üzerine sohbet ve analiz etkinlikleri düzenler.
                    </p>
                </div>
            </div>
        </div>

    </div>

</div>